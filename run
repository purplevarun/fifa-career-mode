#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FRONTEND_DIR="$ROOT_DIR/frontend"
cd "$ROOT_DIR"

usage() {
  cat <<'EOF'
Usage: ./run <start|process> [args...]

Commands:
  start        Start the local dashboard at http://127.0.0.1:5000
  process      Scan raw_screenshots/ and save new OCR results to local SQLite
EOF
}

command_name=${1:-}
if [ "$#" -gt 0 ]; then
  shift
fi

case "$command_name" in
  start)
    exec npm --prefix "$FRONTEND_DIR" run dev -- --port 5000 --strictPort "$@"
    ;;
  process)
    exec python3 -m processing process "$@"
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
