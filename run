#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
FRONTEND_DIR="$ROOT_DIR/frontend"
cd "$ROOT_DIR"

usage() {
  cat <<'EOF'
Usage: ./run <command> [args...]

Commands:
  process      Scan raw_screenshots/ and save new OCR results to local SQLite
  approve      Save visually checked OCR records to the stats database
  review       Create a review file from existing OCR results
  status       Show saved stats and pending processing
  backup       Back up the local SQLite database to a new file
  dev          Start the local dashboard
  build        Build the local dashboard
  preview      Open the built dashboard with the local SQLite endpoint
  test         Run Python and frontend tests
  e2e          Run Playwright browser tests
  lint         Run Oxlint
  check        Run tests, lint, and build
  format       Format frontend files and README
EOF
}

command_name=${1:-}
shift || true

case "$command_name" in
  format)
    exec "$FRONTEND_DIR/node_modules/.bin/prettier" --write \
      "$FRONTEND_DIR/package.json" "$FRONTEND_DIR/*.ts" \
      "$FRONTEND_DIR/src" "$FRONTEND_DIR/tests" "$ROOT_DIR/README.md"
    ;;
  dev|build|preview|lint)
    exec npm --prefix "$FRONTEND_DIR" run "$command_name" -- "$@"
    ;;
  e2e)
    exec npm --prefix "$FRONTEND_DIR" run test:e2e -- "$@"
    ;;
  test)
    python3 -W error::ResourceWarning -m unittest discover -s processing/tests -q
    exec npm --prefix "$FRONTEND_DIR" test -- "$@"
    ;;
  check)
    "$ROOT_DIR/run" test
    npm --prefix "$FRONTEND_DIR" run lint
    exec npm --prefix "$FRONTEND_DIR" run build
    ;;
  process|approve|review|status|backup|inventory|validate|report|reconcile|export)
    exec python3 -m processing "$command_name" "$@"
    ;;
  ''|-h|--help|help)
    usage
    ;;
  *)
    printf 'Unknown command: %s\n\n' "$command_name" >&2
    usage >&2
    exit 2
    ;;
esac
